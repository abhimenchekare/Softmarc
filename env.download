# Local Development Configuration
# This uses SQLite - no MySQL installation needed!

# For local testing with SQLite (default)
DB_TYPE=sqlite
DB_FILE=./softmarc.db

# For local testing with MySQL (uncomment if you have MySQL installed)
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=softmarc
# DB_USER=root
# DB_PASS=your_password

PORT=3000
